# MongoDB Atlas Connection URI
# Example: mongodb+srv://admin:YourPassword123@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database Name (default: netflix_nftoken)
MONGODB_DB_NAME=netflix_nftoken

# Secret for JWT admin session tokens
JWT_SECRET=super-secret-jwt-key-netflix-nftoken-2026
